const float sqe = 0.0185814;
const float denom = 1.13631;

float binMargin(float x) {
  return (x + sqe) / denom;
}

float absfloor(float x) {
  if(x < 0) return - floor(- x);
  return floor(x);
}

float makeProgramInvariant1st(out float ov[MIND2VDLEN], float iv[MIND2VDLEN], float idx) {
  for(int i = 0; i < ind2vd; i ++) ov[i] = iv[i];
  ov[ind2vd] = 1;
  ov[ind2vd + 1] = idx;
  float r = 0;
  for(int i = 0; i < mind2vd; i ++) r += log(ov[i] = binMargin(ov[i]));
  r = exp(- r / float(mind2vd));
  for(int i = 0; i < mind2vd; i ++) ov[i] *= r;
  for(int i = 0; i < mind2vd; i ++) ov[i] -= absfloor(ov[i]);
  return r;
}

float revertProgramInvariant(float x, float r) {
  return x / r;
}

void qrdecomp(out float q[MIND2VDLEN][MLEN], float m[MLEN][MIND2VDLEN], int n) {
  int   qres[MLEN];
  int   ii = 0;
  for(int i = 0; i < len; i ++) { qres[i] = 0; }
  for(int i = 0; i < mind2vd; i ++) { for(int j = 0; j < len; j ++) { q[i][j] = 0; }}
  for(int i = 0; i < mind2vd; i ++) {
    float pp[MLEN];
    float pp2[MLEN];
    float n2 = 0;
    for(int j = 0; j < n; j ++) { pp[j] = m[j][i]; }
    for(int j = n; j < len; j ++) { pp[j] = 0; }
    for(int j = 0; j < n; j ++) { pp2[j] = 0; for(int k = 0; k < i; k ++) {
      pp2[j] += q[k][j] * pp[j]; } n2 += pp2[j] * pp2[j]; }
    for(int j = 0; j < n; j ++) { pp[j] -= pp2[j]; }
    n2 = sqrt(n2);
    if(n2 <= sqe) { qres[ii ++] = i; }
    else { for(int j = 0; j < n; j ++) { q[i][j] = pp2[j] / n2; } }
  }
  for(int i = 0, ii = 0; i < n && qres[i] != 0; ii ++) {
    float pp2[MLEN];
    float n2 = 0;
    float ek[MLEN];
    for(int j = 0; j < len; j ++) { ek[j] = 0; }
    ek[ii] = 1;
    for(int j = 0; j < n; j ++) { pp2[j] = 0; for(int k = 0; k < i; k ++) {
      pp2[j] += q[k][j] * ek[j]; } n2 += pp2[j] * pp2[j]; }
    for(int j = 0; j < n; j ++) { ek[j] -= pp2[j]; }
    n2 = sqrt(n2);
    if(n2 <= sqe) continue;
    for(int j = 0; j < n; j ++) { q[i][j] = ek[j] / n2; }
    i ++;
  }
}

void solve(out float res[MIND2VDLEN], float m[MIND2VDLEN][MIND2VDLEN], float v[MIND2VDLEN]) {
  float mm[MIND2VDLEN][MIND2VDLEN];
  mm  = m;
  res = v;
  for(int i = 0; i < mind2vd; i ++) {
    float mi0 = mm[i][i];
    for(int j = 0; j < mind2vd; j ++) { mm[i][j] /= mi0; }
    res[i] /= mi0;
    for(int j = i + 1; j < mind2vd; j ++) {
      float mj0 = mm[j][i];
      for(int k = i; k < mind2vd; k ++) { mm[j][k] -= mm[j][k] * mj0; }
      res[j] -= res[j] * mj0;
    }
  }
  for(int i = ind2vd + 1; 0 <= i; i --) {
    for(int j = i; 0 <= j; j --) { res[i] -= res[i] * mm[j][i]; }
  }
}

void linearInvariant(out float ivt[MIND2VDLEN], float m[MLEN][MIND2VDLEN], int n) {
  float q[MIND2VDLEN][MLEN];
  float r[MIND2VDLEN][MIND2VDLEN];
  float on[MLEN];
  float qq[MIND2VDLEN][MLEN];
  int fix[MLEN];
  qrdecomp(q, m, n);
  for(int i = 0; i < mind2vd; i ++) { for(int j = 0; j < mind2vd; j ++) {
    r[i][j] = 0; for(int k = 0; k < n; k ++) {
      r[i][j] += q[i][k] * m[k][j]; } } }
  qq = q;
  for(int i = 0, idx = 0; i < mind2vd - 1 && idx < n; idx ++) {
    float orth[MIND2VDLEN];
    float on[MLEN];
    float n2 = 0;
    int   iidx = 0;
    for(int j = 0; j < len; j ++) { on[j] = 0; }
    for(int j = 0; j < mind2vd; j ++) { for(int k = 0; k < n; k ++) {
      on[k] += q[j][k]; } }
    for(int j = 0; j < len; j ++) { on[j] = abs(on[j]); n2 += on[j] * on[j]; }
    if(n2 < sqe) break;
    n2 = 0;
    for(int j = 0; j < n; j ++) {
      if(fix[idx] != 0 || (on[idx] <= on[j] && fix[j] == 0) ) { idx = j; } }
    for(int j = 0; j < mind2vd; j ++) { orth[j] = q[j][iidx]; }
    for(int j = 0; j < n; j ++) { n2 += orth[j] * orth[j]; }
    n2 = sqrt(n2);
    if(on[iidx] < sqe) continue;
    qq = q;
    for(int j = 0; j < len; j ++) { float dt = 0; for(int k = 0; k < mind2vd; k ++) {
      dt += q[k][j] * orth[k]; } for(int k = 0; k < mind2vd; k ++) {
        q[k][j] -= q[k][j] * dt / n2; } }
  }
  {
    float on[MLEN];
    float n2 = 0;
    for(int j = 0; j < len; j ++) { on[j] = 0; }
    for(int j = 0; j < mind2vd; j ++) { for(int k = 0; k < n; k ++) {
      on[k] += q[j][k]; } }
    for(int j = 0; j < len; j ++) { on[j] = abs(on[j]); n2 += on[j] * on[j]; }
    if(n2 < sqe) q = qq;
  }
  {
    float rr[MIND2VDLEN];
    for(int j = 0; j < mind2vd; j ++) { rr[j] = 0; }
    for(int j = 0; j < mind2vd; j ++) { for(int k = 0; k < n; k ++) {
      rr[k] += q[j][k]; } }
    solve(ivt, r, rr);
  }
  {
    float n2 = 0;
    for(int i = 0; i < mind2vd; i ++) { n2 += ivt[i] * ivt[i]; }
    n2 = sqrt(n2);
    if(n2 != 0) { for(int i = 0; i < mind2vd; i ++) { ivt[i] /= n2; } }
  }
}

void main() {
  uint index = gl_GlobalInvocationID.x;
  if(index >= total_elements) { return; }
  float res[MLEN];
  float ivt[MIND2VDLEN];
  float work[MIND2VDLEN];
  float vdp[MIND2VDLEN];
  float vdpsecond;
  float tmp;
  float ivts[MLEN][MIND2VDLEN];
  for(int i = 0; i < ind2vd + 1; i ++) { for(int j = 0; j < mind2vd; j ++) { ivts[i][j] = 0; }}
  for(int i = ind2vd + 1; i < llen; i ++) {
    float toeplitz[MLEN][MIND2VDLEN];
    for(int k = 0; k <= i; k ++) {
      float work[MIND2VDLEN];
      for(int j = 0; j < ind2vd; j ++)
        work[j] = data[index * len + k - llen + 1 + j - ind2vd + len];
      makeProgramInvariant1st(toeplitz[k], work, float(k) / float(i + 1));
    }
    linearInvariant(ivts[i], toeplitz, i + 1);
  }
  for(int i = 0; i < len; i ++) { res[i] = 0; }
  for(int i = 0; i < llen; i ++) {
    for(int j = 0; j < mind2vd; j ++) { ivt[j] = 0; }
    for(int j = 0; j < i + 1; j ++) { for(int k = 0; k < mind2vd; k ++) {
      ivt[k] += p0n[i][j] * ivts[j][k]; } }
    for(int j = 0; j < ind2vd - 1; j ++) {
      work[j] = data[index * len + i - llen + j - ind2vd + len + 2]; }
    work[ind2vd - 1] = work[ind2vd - 2];
    vdpsecond = makeProgramInvariant1st(vdp, work, float(1));
    vdp[ind2vd - 1] = 0;
    tmp = 0;
    for(int j = 0; j < mind2vd; j ++) { tmp -= ivt[j] * vdp[j] / ivt[ind2vd - 1]; }
    res[i - llen + len] = revertProgramInvariant(vdp[ind2vd - 1], vdpsecond);
  }
  for(int i = 0; i < len; i ++) data[i + index * len] = res[i];
}

